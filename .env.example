# ==== Telegram ====
BOT_TOKEN=123456:REPLACE_ME
ADMIN_TG_IDS=111111111            # через запятую: кому слать служебные уведомления

# ==== База данных ====
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=tarobot
POSTGRES_USER=tarobot
POSTGRES_PASSWORD=REPLACE_ME

# ==== Redis / очередь ====
REDIS_HOST=redis
REDIS_PORT=6379

# ==== ИИ (OpenAI Responses API) ====
AI_PROVIDER=openai
OPENAI_API_KEY=REPLACE_ME
AI_MODEL_PRIMARY=gpt-5.6-luna
AI_MODEL_FALLBACK=gpt-5.4-nano
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
AI_DAILY_BUDGET_USD=5.0
AI_MONTHLY_BUDGET_USD=100.0
AI_BUDGET_ACTION=block            # block | fallback

# Только администраторы из ADMIN_TG_IDS увидят кнопку обхода оплаты
TEST_PAYMENT_ENABLED=false

# ==== Админ-панель ====
ADMIN_SECRET_KEY=REPLACE_ME_LONG_RANDOM
ADMIN_SESSION_TTL_MINUTES=60
# false — доступ по http://IP:порт; для HTTPS установите true
ADMIN_COOKIE_SECURE=false
ADMIN_PANEL_HOST=0.0.0.0
ADMIN_PANEL_PORT=8000

# ==== Натальные карты (Swiss Ephemeris) ====
# true — установить pyswisseph при сборке. Библиотека под AGPL: для закрытого коммерческого
# бота нужна Swiss Ephemeris Professional License. Пока false, услуги натальной карты
# в боте показываются как временно недоступные и оплата по ним не принимается.
# После изменения: docker compose up -d --build
INSTALL_SWISSEPH=false

# ==== Геокодинг (Nominatim/OSM по умолчанию) ====
GEOCODER_URL=https://nominatim.openstreetmap.org/search

# ==== Общее ====
TIMEZONE_DISPLAY=Europe/Moscow    # UTC+3 для «карты дня»
ENVIRONMENT=production            # production | development
